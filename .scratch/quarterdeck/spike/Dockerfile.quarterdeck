# Throwaway spike image. Not hardened, pins are loose on purpose.
FROM node:24-bookworm-slim
ARG CLAUDE_CODE_VERSION=2.1.310
ARG DOCKER_VERSION=28.1.1
ARG GH_VERSION=2.62.0
RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates jq procps less openssh-client \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_VERSION}.tgz \
      | tar -xz -C /usr/local/bin --strip-components=1 docker/docker \
 && curl -fsSL https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz \
      | tar -xz -C /usr/local --strip-components=1 gh_${GH_VERSION}_linux_amd64/bin/gh
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} tasks-axi quota-axi gh-axi \
 && claude --version
COPY fm-install-herdr.sh fm-install-treehouse.sh /tmp/
RUN bash /tmp/fm-install-herdr.sh /usr/local/bin && bash /tmp/fm-install-treehouse.sh /usr/local/bin
# The launcher named `claude` must come first on PATH.
COPY bin/claude /opt/qd/bin/claude
RUN chmod 755 /opt/qd/bin/claude
ENV PATH=/opt/qd/bin:$PATH
USER node
CMD ["sleep", "infinity"]
