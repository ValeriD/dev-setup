#!/bin/sh
# Git credential helper: answers only for https://github.com, only from the
# repo-scoped PAT in DEV_SETUP_GITHUB_PAT. Anything else returns nothing.
[ "$1" = get ] || exit 0
proto= host=
while IFS='=' read -r k v; do
  case "$k" in protocol) proto=$v ;; host) host=$v ;; esac
done
[ "$proto" = https ] && [ "$host" = github.com ] && [ -n "$DEV_SETUP_GITHUB_PAT" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$DEV_SETUP_GITHUB_PAT"
