{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/valerid/dev-setup/main/installer/extensions.schema.json",
  "title": "Dev Setup Extension Manifest",
  "description": "Declares one Extension Layer: Agent Extensions with a Pinned Ref, and extra Egress Allowlist domains.",
  "type": "object",
  "required": ["extensions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string", "minLength": 1, "description": "One line saying what the set is for. Required in a Preset file (presets/<name>.json); ignored by the installer." },
    "notes": { "type": "array", "items": { "type": "string" }, "description": "Free-form notes; ignored by the installer." },
    "extensions": { "type": "array", "items": { "$ref": "#/definitions/entry" } },
    "egress": { "$ref": "#/definitions/domains", "description": "Domains the layer itself needs, independent of any entry. Removing an extension never removes one of these; a domain an extension needs goes on that entry's own egress." }
  },
  "definitions": {
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
      "description": "A plain lower-case hostname. It also covers its subdomains."
    },
    "domains": { "type": "array", "items": { "$ref": "#/definitions/domain" }, "description": "Extra domains for the Egress Allowlist." },
    "entryEgress": { "$ref": "#/definitions/domains", "description": "Domains this extension needs. They reach the Egress Allowlist and go with the entry when it is removed." },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "Pinned Ref: a full 40-character commit SHA. Branches and tags are not allowed." },
    "exactVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "Pinned Ref: an exact package version. Ranges and dist-tags are not allowed."
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["claude", "codex"] },
      "description": "Which Agents receive the entry. Not every kind is supported by every Agent."
    },
    "githubSource": {
      "type": "object",
      "required": ["github", "path", "sha"],
      "additionalProperties": false,
      "properties": {
        "github": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "description": "owner/repo" },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\0]+$", "description": "Relative path inside the repository. '.' is the root." },
        "sha": { "$ref": "#/definitions/sha" }
      }
    },
    "presetName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "A Preset's name: its file name in presets/ without .json." },
    "envNames": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" } },
    "entry": {
      "type": "object",
      "required": ["kind", "agents"],
      "properties": {
        "kind": { "enum": ["skill", "plugin", "mcp", "mcp-remote", "hook"] },
        "agents": { "$ref": "#/definitions/agents" },
        "preset": { "$ref": "#/definitions/presetName", "description": "The Preset this entry was copied from (ADR 0005). Ignored by the installer." }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "skill" } }, "required": ["kind"] },
          "then": {
            "required": ["source"],
            "additionalProperties": false,
            "properties": {
              "kind": {},
              "agents": {},
              "preset": {},
              "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "Skill directory name. Defaults to the last segment of source.path." },
              "source": { "$ref": "#/definitions/githubSource" },
              "egress": { "$ref": "#/definitions/entryEgress" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "plugin" } }, "required": ["kind"] },
          "then": {
            "required": ["source"],
            "additionalProperties": false,
            "properties": {
              "kind": {},
              "agents": {},
              "preset": {},
              "source": {
                "oneOf": [
                  { "$ref": "#/definitions/githubSource" },
                  {
                    "type": "object",
                    "required": ["marketplace", "plugin", "sha"],
                    "additionalProperties": false,
                    "properties": {
                      "marketplace": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
                      "plugin": { "type": "string", "minLength": 1 },
                      "sha": { "$ref": "#/definitions/sha" }
                    }
                  }
                ]
              },
              "egress": { "$ref": "#/definitions/entryEgress" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "mcp" } }, "required": ["kind"] },
          "then": {
            "required": ["name", "source"],
            "additionalProperties": false,
            "properties": {
              "kind": {},
              "agents": {},
              "preset": {},
              "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
              "source": {
                "type": "object",
                "required": ["npm", "version"],
                "additionalProperties": false,
                "properties": {
                  "npm": { "type": "string", "minLength": 1 },
                  "version": { "$ref": "#/definitions/exactVersion" }
                }
              },
              "env": { "$ref": "#/definitions/envNames" },
              "egress": { "$ref": "#/definitions/entryEgress" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "mcp-remote" } }, "required": ["kind"] },
          "then": {
            "required": ["name", "url", "egress"],
            "additionalProperties": false,
            "properties": {
              "kind": {},
              "agents": {},
              "preset": {},
              "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
              "url": { "type": "string", "pattern": "^https://" },
              "bearerTokenEnv": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$", "description": "Name of the host env var holding a bearer token for the server. Only the name is declared, never the value." },
              "egress": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/domain" }, "description": "Domains this server needs, at least its own host. They reach the Egress Allowlist and go with the entry when it is removed." }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "hook" } }, "required": ["kind"] },
          "then": {
            "required": ["event", "source"],
            "additionalProperties": false,
            "properties": {
              "kind": {},
              "agents": {},
              "preset": {},
              "event": { "type": "string", "minLength": 1 },
              "matcher": { "type": "string" },
              "source": { "$ref": "#/definitions/githubSource" },
              "egress": { "$ref": "#/definitions/entryEgress" }
            }
          }
        }
      ]
    }
  }
}
