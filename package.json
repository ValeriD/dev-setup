{
  "name": "dev-setups",
  "private": true,
  "type": "module",
  "scripts": {
    "test:installer": "node --test installer/test/*.test.mjs",
    "test:skill": "node --test skills/dev-container/scripts/test/*.test.mjs",
    "test:quarterdeck": "DEV_SETUP_TEST_SKIP_BUILD=1 node --test --test-global-setup=tests/global-setup.mjs --test-timeout=900000 tests/quarterdeck.test.mjs",
    "test": "node --test --test-global-setup=tests/global-setup.mjs --test-concurrency=${DEV_SETUP_TEST_CONCURRENCY:-3} --test-timeout=900000 tests/*.test.mjs"
  }
}
