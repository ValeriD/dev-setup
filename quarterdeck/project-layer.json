{
  "$schema": "https://raw.githubusercontent.com/ValeriD/dev-setup/main/installer/extensions.schema.json",
  "description": "Quarterdeck-added entries for a project's Extension Layer: qd-project-up appends them to the exported .devcontainer/extensions.json of a container it creates. Never part of Base, the Variant or a Template.",
  "notes": [
    "Ticket 15: FirstMate's Crewmate busy and turn-end signals under the hardened policy (allowManagedHooksOnly). The script is inert without FM_TASK_ID and FM_TASK_INBOX.",
    "The sha is a commit that already contains the script; change the script, then re-pin in a later commit."
  ],
  "extensions": [
    {
      "kind": "hook",
      "agents": [
        "claude"
      ],
      "event": "UserPromptSubmit",
      "source": {
        "github": "ValeriD/dev-setup",
        "path": "quarterdeck/hooks/crewmate-busy.sh",
        "sha": "df7ccd641d2d368f2225a3cfb6910e5035efd72f"
      }
    },
    {
      "kind": "hook",
      "agents": [
        "claude"
      ],
      "event": "Stop",
      "source": {
        "github": "ValeriD/dev-setup",
        "path": "quarterdeck/hooks/crewmate-busy.sh",
        "sha": "df7ccd641d2d368f2225a3cfb6910e5035efd72f"
      }
    },
    {
      "kind": "hook",
      "agents": [
        "claude"
      ],
      "event": "StopFailure",
      "source": {
        "github": "ValeriD/dev-setup",
        "path": "quarterdeck/hooks/crewmate-busy.sh",
        "sha": "df7ccd641d2d368f2225a3cfb6910e5035efd72f"
      }
    },
    {
      "kind": "hook",
      "agents": [
        "claude"
      ],
      "event": "SessionEnd",
      "source": {
        "github": "ValeriD/dev-setup",
        "path": "quarterdeck/hooks/crewmate-busy.sh",
        "sha": "df7ccd641d2d368f2225a3cfb6910e5035efd72f"
      }
    }
  ]
}
