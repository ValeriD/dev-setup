{
  "name": "node",
  "image": "${templateOption:image}",
  // Only what image metadata cannot carry lives here.
  "runArgs": ["--cap-drop=ALL", "--memory=8g", "--pids-limit=2048"],
  "initializeCommand": "test -d .git || git init -q; mkdir -p .git/hooks .vscode .devcontainer; touch .git/config",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  // Repo-scoped PAT (empty when the host var is unset) and git identity from the host.
  "remoteEnv": {
    "DEV_SETUP_GITHUB_PAT": "${localEnv:${templateOption:patEnvVar}}",
    "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
    "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
    "GIT_COMMITTER_NAME": "${localEnv:GIT_AUTHOR_NAME}",
    "GIT_COMMITTER_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}"
  },
  // MCP secrets: an Extension Manifest names the host env vars an MCP server needs
  // (`env`, or `bearerTokenEnv` for a remote server). To pass one, add a line to
  // remoteEnv above, e.g.  "MY_MCP_TOKEN": "${localEnv:MY_MCP_TOKEN}"
  // Only that reference is committed, never the value. A named secret that is unset
  // prints a warning when the container starts.
  // Read-only overlays: block planting code that would run later on the host.
  "mounts": [
    "source=${localWorkspaceFolder}/.git/hooks,target=/workspace/.git/hooks,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/config,target=/workspace/.git/config,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,type=bind,readonly",
    "source=${localWorkspaceFolder}/.vscode,target=/workspace/.vscode,type=bind,readonly"
  ]
}
