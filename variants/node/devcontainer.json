// Build-time config only. `devcontainer build` turns everything below into the
// image's devcontainer.metadata label, so the hardening travels with the digest.
{
  "name": "dev-setup node",
  "build": { "dockerfile": "Dockerfile", "context": "../.." },
  "remoteUser": "node",
  "containerUser": "node",
  "init": true,
  "securityOpt": ["no-new-privileges"],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "CODEX_HOME": "/home/node/.codex",
    "DISABLE_AUTOUPDATER": "1",
    "GIT_CONFIG_GLOBAL": "/etc/dev-setup/gitconfig"
  },
  // Blank the host-credential bridges VS Code injects; the scrubber re-clears
  // them in every shell and removes the sockets after start.
  "remoteEnv": {
    "SSH_AUTH_SOCK": "",
    "GPG_AGENT_INFO": "",
    "BROWSER": "",
    "GIT_ASKPASS": "",
    "VSCODE_IPC_HOOK_CLI": "",
    "VSCODE_GIT_IPC_HANDLE": ""
  },
  "postStartCommand": "sh /etc/profile.d/dev-setup-scrub.sh",
  "mounts": [
    "source=claude-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=codex-${devcontainerId},target=/home/node/.codex,type=volume"
  ]
}
