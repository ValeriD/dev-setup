// Build-time config only. `devcontainer build` turns everything below into the
// image's devcontainer.metadata label, so the hardening travels with the digest.
{
  "name": "dev-setup node",
  // REVISION becomes the image's org.opencontainers.image.revision label.
  "build": { "dockerfile": "Dockerfile", "context": "../..", "args": { "REVISION": "${localEnv:DEV_SETUP_REVISION}" } },
  "remoteUser": "node",
  // Root only for the start-up entrypoint; every dev-user process runs as `node`
  // (remoteUser). Template adds --cap-drop=ALL, so root holds just these caps.
  // DAC_READ_SEARCH lets root read the project's .devcontainer/extensions.json
  // when the project directory is owner-only (mode 700), which is common.
  "containerUser": "root",
  "features": { "./.devcontainer/features/egress": {} },
  "capAdd": ["NET_ADMIN", "NET_RAW", "DAC_READ_SEARCH"],
  "init": true,
  "securityOpt": ["no-new-privileges"],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "CODEX_HOME": "/home/node/.codex",
    "DISABLE_AUTOUPDATER": "1",
    // Where the start-up step reads the Consuming Project layer (.devcontainer/extensions.json).
    "DEV_SETUP_WORKSPACE": "/workspace",
    "GIT_CONFIG_GLOBAL": "/etc/dev-setup/gitconfig",
    // pnpm supply-chain policy (ADR 0001). pnpm 11 honours only some keys from
    // its global config.yaml (not trustPolicy, strictDepBuilds, frozenLockfile),
    // so the policy is set through pnpm_config_* env, which covers every key.
    // A project can still allow one build via allowBuilds in pnpm-workspace.yaml.
    "pnpm_config_minimum_release_age": "10080",
    "pnpm_config_minimum_release_age_strict": "true",
    "pnpm_config_trust_policy": "no-downgrade",
    "pnpm_config_strict_dep_builds": "true",
    "pnpm_config_block_exotic_subdeps": "true",
    "pnpm_config_frozen_lockfile": "true",
    // Ad-hoc npm / npx: no lifecycle scripts, 7-day cooldown, exact pins.
    "NPM_CONFIG_IGNORE_SCRIPTS": "true",
    "NPM_CONFIG_MIN_RELEASE_AGE": "7",
    "NPM_CONFIG_SAVE_EXACT": "true",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false"
  },
  // Blank the host-credential bridges VS Code injects; the scrubber re-clears
  // them in every shell and removes the sockets after start.
  "remoteEnv": {
    "SSH_AUTH_SOCK": "",
    "GPG_AGENT_INFO": "",
    "BROWSER": "",
    "GIT_ASKPASS": "",
    "VSCODE_IPC_HOOK_CLI": "",
    "VSCODE_GIT_IPC_HANDLE": ""
  },
  "postStartCommand": "sh /usr/local/share/egress/wait-ready.sh && sh /etc/profile.d/dev-setup-scrub.sh && sh /usr/local/share/dev-setup/check-secrets.sh",
  "mounts": [
    "source=claude-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=codex-${devcontainerId},target=/home/node/.codex,type=volume"
  ]
}
